# Local single-user login. The app falls back to "dev" when this is unset.
DEV_AUTH_PASSWORD=dev

# Signs the session cookie. A development default is used when this is unset.
SESSION_SECRET=replace-me

# Calendar day used for "today", overdue, and the daily plan.
APP_TIMEZONE=America/New_York

# sqlite (default) or supabase. sqlite needs no credentials.
DATA_PROVIDER=sqlite

# Required only when DATA_PROVIDER=supabase.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Service role bypasses RLS. The provider still filters every query by user id.
# SUPABASE_SERVICE_ROLE_KEY=
# Optional user JWT so the anon key runs as that user (RLS: user_id = auth.uid()).
# SUPABASE_ACCESS_TOKEN=

# When set, the assistant streams through the Vercel AI SDK. When unset, a
# small local parser still proposes tasks and a daily plan.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Read-only Google Calendar. All three are required. The app never writes events.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Protects /api/cron/daily-plan. Unset means the route refuses every request.
# CRON_SECRET=
